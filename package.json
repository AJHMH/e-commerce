{
  "name": "e-commerce",
  "description": "SvelteKit e-commerce MVP (Digital Atelier) with mock catalog, cart, checkout, and localStorage orders—design from Stitch artifacts.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaron-howard/e-commerce.git"
  },
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "npm run check",
    "lint": "npm run check",
    "test": "node --test ./tests/smoke.test.js"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/forms": "^0.5.11",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  }
}
